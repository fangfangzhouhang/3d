# Python
__pycache__/
*.pyc
.venv/

# 运行产物（结果图片及相关文件）全部不入库。
output/

# 数据集仅放行图片（png/jpg/jpeg）；原始字节、标注等不入库。
data/**
!data/**/
!data/**/*.png
!data/**/*.jpg
!data/**/*.jpeg

# 本地工具链（scripts/bootstrap-zig.ps1 自动下载，可重新生成）
.tools/

# STM32CubeIDE：真实工程由硬件组首次上传时创建；只忽略可重新生成的产物。
firmware/**/Debug/
firmware/**/Release/
firmware/**/.metadata/
firmware/**/*.o
firmware/**/*.d
firmware/**/*.su
firmware/**/*.elf
firmware/**/*.hex
firmware/**/*.bin
firmware/**/*.axf
firmware/**/*.crf
firmware/**/*.map
firmware/**/*.list
firmware/**/Objects/
firmware/**/Listings/
firmware/**/*.uvguix.*

