# Python 虚拟环境必须由每台电脑按 requirements 重建，不进入 Git。
.venv/
venv/
env/

# Python/测试缓存。
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# IDE 与本机配置。
.idea/
.trae/
.vscode/*.local.json

# 密钥和本地环境。
.env
.env.*
!.env.example

# 运行输出与数据集规则由各子项目 .gitignore 就近管理（output 全忽略，data 仅图片入库）。

# 模型权重需要单独的数据/模型版本管理。
*.pt
*.pth
*.onnx

# STM32CubeIDE 编译产物：保留工程配置与源码，不提交板端二进制。
MicroCleaningVision/firmware/nucleo_f401re/**/Debug/
MicroCleaningVision/firmware/nucleo_f401re/**/Release/
MicroCleaningVision/firmware/nucleo_f401re/**/*.elf
MicroCleaningVision/firmware/nucleo_f401re/**/*.hex
MicroCleaningVision/firmware/nucleo_f401re/**/*.bin
MicroCleaningVision/firmware/nucleo_f401re/.tools/
