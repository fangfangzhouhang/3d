# ============================================
# MicroCleaningVision .gitignore
# ============================================
# 统一忽略规则，避免日志、缓存、运行产物被误追踪
# 分类说明：
#   A. Python相关
#   B. 日志文件
#   C. 运行产物（数据集、模型、临时文件）
#   D. IDE配置文件
#   E. 操作系统文件
#   F. 构建和测试产物
#   G. 本地环境配置
# ============================================

# =========== A. Python相关 ===========
# Python缓存文件
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 虚拟环境
env/
venv/
.venv/
.env/
.tox/
.eggs/
*.egg-info/
dist/
build/
*.egg

# Python包管理
poetry.lock
Pipfile.lock
setup.pyc
*.whl

# =========== B. 日志文件 ===========
# 日志目录和日志文件
logs/
*.log
*.log.*
app.log_*

# 项目内日志输出目录
output/logs/
!output/logs/.gitkeep

# =========== C. 运行产物 ===========
# 数据文件
data/
dataset/
*.db
*.sqlite
*.sqlite3
*.csv
*.json
*.xml
*.npy
*.npz

# 模型权重文件
models/*.pt
models/*.pth
models/*.onnx
models/*.engine
models/*.h5
models/*.pb
!models/__init__.py
!models/.gitkeep

# 输出目录（运行时生成）
output/data/
output/models/
output/datasets/
!output/data/.gitkeep
!output/models/.gitkeep
!output/datasets/.gitkeep

# 临时图像文件
*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.tif
*.gif

# =========== D. IDE配置文件 ===========
# Visual Studio Code
.vscode/
*.swp
*.swo
*~

# JetBrains IDE
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.project
.classpath
.settings/

# NetBeans
nbproject/

# Xcode
*.xcodeproj/
*.xcworkspace/

# =========== E. 操作系统文件 ===========
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Linux
*~
.nfs*
.fuse_hidden*
.bash_history

# =========== F. 构建和测试产物 ===========
# 测试相关
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
nosetests.xml
.tox/

# 文档构建
docs/_build/
docs/.doctrees/

# 打包产物
*.spec
*.exe
*.dll
*.so
*.dylib

# =========== G. 本地环境配置 ===========
# 本地配置文件（不提交，避免覆盖他人配置）
config_local.py
config.yaml
config.json
.local.env
.env.local
.env.*.local

# AI工具缓存
.trae/
.trae-cn/
.trae_cache/
trae_cache/

# Git钩子
.git/hooks/

# =========== H. Jupyter相关 ===========
.ipynb_checkpoints/
*.ipynb

# =========== I. 临时文件 ===========
*.tmp
*.temp
*.bak
*.old
*.backup
